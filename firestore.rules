rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Eigene Daten: nur der Besitzer
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Teilen-Links: jeder darf lesen, nur der Besitzer schreiben
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      match /parts/{partId} {
        allow read: if true;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/shares/$(shareId)).data.owner == request.auth.uid ||
          getAfter(/databases/$(database)/documents/shares/$(shareId)).data.owner == request.auth.uid);
      }
    }

    // Benutzernamen (eindeutig) und öffentliche Profile für angemeldete Nutzer
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Freundesliste: eigene Liste frei, beim anderen nur Anfrage stellen / annehmen / entfernen
    match /friends/{uid}/list/{other} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == other && request.resource.data.status == 'in';
      allow update: if request.auth != null && request.auth.uid == other && resource.data.status == 'out' && request.resource.data.status == 'friend';
      allow delete: if request.auth != null && request.auth.uid == other;
    }

    // Online-Spieltisch: lesen/ändern dürfen nur Mitspieler und Eingeladene
    function tableDoc(t) { return get(/databases/$(database)/documents/tables/$(t)).data; }
    function seated(t) { return request.auth != null && request.auth.uid in tableDoc(t).players; }
    match /tables/{t} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.players || request.auth.uid in resource.data.invited);
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid && request.resource.data.players == [request.auth.uid];
      allow update: if request.auth != null && (request.auth.uid in resource.data.players || request.auth.uid in resource.data.invited)
        && request.resource.data.host == resource.data.host;
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
      match /seats/{uid} {
        allow read: if seated(t);
        allow create: if seated(t) && request.auth.uid == uid;
        allow update: if seated(t);
      }
      match /private/{uid} {
        allow read, write: if request.auth != null && request.auth.uid == uid && seated(t);
      }
      match /events/{e} {
        allow read, create: if seated(t);
      }
    }
  }
}
