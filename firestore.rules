rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Eigene Daten: nur der Besitzer
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Teilen-Links: jeder darf lesen, nur der Besitzer schreiben
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      match /parts/{partId} {
        allow read: if true;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/shares/$(shareId)).data.owner == request.auth.uid ||
          getAfter(/databases/$(database)/documents/shares/$(shareId)).data.owner == request.auth.uid);
      }
    }

    // Benutzernamen (eindeutig) und öffentliche Profile für angemeldete Nutzer
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Freundesliste: eigene Liste frei, beim anderen nur Anfrage stellen / annehmen / entfernen
    match /friends/{uid}/list/{other} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == other && request.resource.data.status == 'in';
      allow update: if request.auth != null && request.auth.uid == other && resource.data.status == 'out' && request.resource.data.status == 'friend';
      allow delete: if request.auth != null && request.auth.uid == other;
    }
  }
}
