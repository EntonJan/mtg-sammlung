rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Eigene Daten: nur der Besitzer
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Teilen-Links: jeder darf lesen, nur der Besitzer schreiben
    match /shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      match /parts/{partId} {
        allow read: if true;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/shares/$(shareId)).data.owner == request.auth.uid ||
          getAfter(/databases/$(database)/documents/shares/$(shareId)).data.owner == request.auth.uid);
      }
    }

    // Benutzernamen (eindeutig) und öffentliche Profile für angemeldete Nutzer
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Freundesliste: eigene Liste frei, beim anderen nur Anfrage stellen / annehmen / entfernen
    match /friends/{uid}/list/{other} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == other && request.resource.data.status == 'in';
      allow update: if request.auth != null && request.auth.uid == other && resource.data.status == 'out' && request.resource.data.status == 'friend';
      allow delete: if request.auth != null && request.auth.uid == other;
    }

    // Spieltisch (aus der MTG Lounge): Räume nur für Mitspieler und Eingeladene
    function room(r) { return get(/databases/$(database)/documents/arena_rooms/$(r)).data; }
    function inRoom(r) { return request.auth != null && request.auth.uid in room(r).players; }
    match /arena_rooms/{r} {
      allow read: if request.auth != null && (request.auth.uid in resource.data.players || request.auth.uid in resource.data.get('invited', []));
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid && request.resource.data.players == [request.auth.uid];
      allow update: if request.auth != null && (request.auth.uid in resource.data.players || request.auth.uid in resource.data.get('invited', []));
      allow delete: if request.auth != null && (resource.data.host == request.auth.uid || request.auth.uid in resource.data.players);
      match /game_state/{p} {
        allow read: if inRoom(r);
        allow create: if request.auth != null && request.auth.uid == p;
        allow delete: if request.auth != null && (request.auth.uid == p || room(r).host == request.auth.uid);
        // eigener Zustand frei; bei Mitspielern nur Leben (z. B. „jeder Gegner verliert X“)
        allow update: if inRoom(r) && (request.auth.uid == p || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['life']));
      }
      // Spielprotokoll: Mitspieler lesen; jeder schreibt nur eigene Einträge; nie ändern; löschen nur Mitspieler (Aufräumen)
      match /log/{entryId} {
        allow read: if inRoom(r);
        allow create: if inRoom(r) && request.resource.data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if inRoom(r);
      }
    }
  }
}
